# Local development (copy to .env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and required: online checkout, staff accounts, and error capture use it.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the owner bootstrap script; never expose either value to browsers.
WAYNES_OWNER_EMAIL=
WAYNES_OWNER_INITIAL_PASSWORD=

LOG_LEVEL=info

# Browser tests only: point at an isolated staging environment, never production.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_RUN_STAGING=0
E2E_MENU_ITEM=Staging Supreme Pizza
E2E_OWNER_STORAGE_STATE=
E2E_POS_STORAGE_STATE=

# Live card payments (Phase 11). Leave unset to keep card payment completely off.
# Sandbox keys come from the Square developer console; production keys replace them
# without any code change. The non-secret application and location IDs are entered
# in Admin -> Payments, not here.
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shared secret the Hanafy CRM presents when it tells Wayne's that a contact was
# deleted there, so the customer is dropped from marketing here too.
INTEGRATION_INBOUND_TOKEN=

# Caller ID (phone-line build). Optional: Admin -> Hardware holds the store's real
# settings; these override them for a development or test deployment only.
#   CALLER_ID_PROVIDER = simulated | cloud | android_native
#   CALLER_LINE_COUNT  = number of physical phone lines (Wayne's has 2)
# UDP port / bind address / box IP are configured in Admin -> Hardware (default 3520);
# a browser never opens UDP, so nothing here is a secret.
CALLER_ID_PROVIDER=
CALLER_LINE_COUNT=
# Token the store's caller ID bridge (scripts/callerid-bridge.mjs) presents to
# /api/phone/calls. Generate with `openssl rand -hex 32`. Unset keeps that route closed.
CALLER_ID_INGEST_TOKEN=
