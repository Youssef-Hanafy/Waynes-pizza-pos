NEXT_PUBLIC_APP_URL=https://orders.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and required: online checkout, staff accounts, and error capture use it.
SUPABASE_SERVICE_ROLE_KEY=
# Supply bootstrap credentials only while running seed:owner, then remove them.
WAYNES_OWNER_EMAIL=
WAYNES_OWNER_INITIAL_PASSWORD=
LOG_LEVEL=info

# Caller ID (phone-line build). Optional: Admin -> Hardware holds the store's real
# settings; these override them for a development or test deployment only.
#   CALLER_ID_PROVIDER = simulated | cloud | android_native
#   CALLER_LINE_COUNT  = number of physical phone lines (Wayne's has 2)
# UDP port / bind address / box IP are configured in Admin -> Hardware (default 3520);
# a browser never opens UDP, so nothing here is a secret.
CALLER_ID_PROVIDER=
CALLER_LINE_COUNT=
# Token the store's caller ID bridge (scripts/callerid-bridge.mjs) presents to
# /api/phone/calls. Generate with `openssl rand -hex 32`. Unset keeps that route closed.
CALLER_ID_INGEST_TOKEN=
